{
  "titulo": "Clima diario de Seattle y Nueva York 2012–2015 · ejemplo de Xila",
  "tema": "light",
  "datos": { "clima": "data/clima.csv", "clima_mensual": "data/clima_mensual.csv" },
  "filtros": [
    {
      "tipo": "fechas",
      "datos": "clima",
      "columna": "fecha",
      "etiqueta": "Fechas",
      "tambien": ["clima_mensual"]
    },
    {
      "tipo": "categoria",
      "datos": "clima",
      "columna": "ciudad",
      "etiqueta": "Ciudad",
      "multiple": true,
      "tambien": ["clima_mensual"]
    }
  ],
  "paneles": [
    {
      "tipo": "kpi",
      "titulo": "Máxima promedio del último mes (°C)",
      "datos": "clima",
      "valor": { "columna": "temp_max_c", "agregado": "mean", "formato": "numero" },
      "comparar": { "columna": "fecha", "periodo": "month" },
      "ancho": 4
    },
    {
      "tipo": "kpi",
      "titulo": "Lluvia del último mes (mm)",
      "datos": "clima",
      "valor": { "columna": "lluvia_mm", "agregado": "sum", "formato": "entero" },
      "comparar": { "columna": "fecha", "periodo": "month" },
      "ancho": 4
    },
    {
      "tipo": "kpi",
      "titulo": "Viento promedio del último mes (m/s)",
      "datos": "clima",
      "valor": { "columna": "viento_ms", "agregado": "mean", "formato": "numero" },
      "comparar": { "columna": "fecha", "periodo": "month" },
      "ancho": 4
    },
    {
