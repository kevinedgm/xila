      "y": "ciudad",
      "valor": "lluvia_mm",
      "agregado": "sum",
      "periodo": "month"
    },
    {
      "tipo": "calor",
      "forma": "tabla",
      "titulo": "¿Cuántos días llueve cada mes? · promedio 2012–2015",
