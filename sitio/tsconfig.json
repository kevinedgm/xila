{
  "extends": "../tsconfig.base.json",
  "include": [
    "demos/**/*.ts",
    "live/**/*.ts",
    "src/.demos/**/*.ts",
    ".vitepress/**/*.ts",
    "tests/**/*.ts",
    "env.d.ts"
  ],
  "exclude": [".vitepress/cache", ".vitepress/dist"],
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "types": ["vite/client", "node"],
    "paths": {
      "@demos/*": ["./demos/*"],
      "@gen-demos/*": ["./src/.demos/*"],
      "@live/*": ["./live/*"],
      "@marca/*": ["../marca/*"]
    }
  }
}
