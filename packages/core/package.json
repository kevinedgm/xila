{
  "name": "xilaplot",
  "version": "0.1.0",
  "description": "Motor de gráficos de Xila.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fuentes/xila.css": "./fuentes/xila.css",
    "./fuentes/*": "./fuentes/*"
  },
  "files": [
    "dist",
    "fuentes/*.css",
    "fuentes/*.woff2",
    "fuentes/*.txt",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinedgm/xila.git",
    "directory": "packages/core"
  },
  "homepage": "https://kevinedgm.github.io/xila/",
  "bugs": "https://github.com/kevinedgm/xila/issues",
  "keywords": [
    "charts",
    "plot",
    "canvas",
    "webgl",
    "dashboard",
    "typescript",
    "csv",
    "pandas"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
